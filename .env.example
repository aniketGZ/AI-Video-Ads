# =====================================================================
# Self-Hosted Open-Source GPU Models (GCP server-hosting-510312)
# =====================================================================

# Feature flag: set true to prioritize self-hosted models, false for Gemini
USE_SELF_HOSTED=true

# If true, falls back to Gemini if the self-hosted server is offline or fails
FALLBACK_TO_GEMINI=true

# ---------------------------------------------------------------------
# Image Server: Qwen-Image-2.1
# Output: PNG (text-to-image & image editing)
# Startup script (server owner): .\image-on.ps1 (~3-10 min)
# ---------------------------------------------------------------------
IMAGE_API_URL=http://35.239.44.254:8000
IMAGE_API_KEY=

# ---------------------------------------------------------------------
# Video Server: MiniMax-H3
# Output: MP4 (H.264 video + stereo audio)
# Startup script (server owner): .\video-on.ps1 (~3-10 min)
# ---------------------------------------------------------------------
VIDEO_API_URL=http://136.115.27.165:8000
VIDEO_API_KEY=

# ---------------------------------------------------------------------
# Gemini API Key (Google AI Studio)
# Used for campaign copywriting/analysis, and as fallback for image/video
# ---------------------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------------------
# Optional 3rd party providers
# ---------------------------------------------------------------------
PIXABAY_API_KEY=
KIE_API_KEY=
