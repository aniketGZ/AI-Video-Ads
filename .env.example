# ---------------------------------------------------------------------
# Gemini API Key (Google AI Studio)
# Powers brand analysis, prompt writing, Nano Banana Pro images and
# Omni Flash videos. Users can also paste their own key in the app.
# ---------------------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------------------
# Server housekeeping
# ---------------------------------------------------------------------
# Comma-separated origins allowed to call this API from other websites.
# Leave empty when only the bundled UI is used (same origin).
CORS_ORIGINS=

# Delete files in static/generated older than this many days (empty = never).
GENERATED_MAX_AGE_DAYS=

# Omni Flash video model (default: gemini-omni-1.1-flash)
# OMNI_MODEL=gemini-omni-1.1-flash
